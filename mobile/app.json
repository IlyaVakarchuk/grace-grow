{
  "expo": {
    "name": "Grace",
    "slug": "grace",
    "version": "1.0.0",
    "scheme": "grace",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F"
      }
    },
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
